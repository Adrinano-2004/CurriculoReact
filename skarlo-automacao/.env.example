# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# --- Claude (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp Cloud API (developers.facebook.com -> seu app -> WhatsApp -> Configuração da API) ---
# Token de acesso PERMANENTE (crie um "usuário do sistema" no Business Manager)
WHATSAPP_TOKEN=
# "Identificação do número de telefone" (Phone number ID), não é o número em si
WHATSAPP_PHONE_NUMBER_ID=
# Senha que VOCÊ inventa e cola também na tela de Webhook da Meta
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-longa-aqui
# App -> Configurações do app -> Básico -> "Chave secreta do aplicativo"
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Seu WhatsApp pessoal (só números, com DDI). Recebe os avisos de lead e pode mandar comandos /bot
DONO_WHATSAPP=5511999999999

# Opcional: URL de webhook para receber os avisos de lead (ex: webhook de um canal do Discord)
NOTIFICACAO_WEBHOOK_URL=

PORT=3000

# --- Prospecção (console.cloud.google.com -> ativar "Places API (New)" -> criar chave) ---
GOOGLE_PLACES_API_KEY=
